{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/playbook/brief.mjs\" --hook --format codex",
            "timeout": 10,
            "statusMessage": "Reading the session brief"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/playbook/autosave.mjs\" --event stop --host Codex",
            "timeout": 30,
            "statusMessage": "Checking the capture pass"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/playbook/autosave.mjs\" --event precompact --host Codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
